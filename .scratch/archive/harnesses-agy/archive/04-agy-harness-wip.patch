+// TestAgyTurnStateReadsProbeTranscripts reports done for the probe's finished
+// turns and running while a turn still owes work.
+func TestAgyTurnStateReadsProbeTranscripts(t *testing.T) {
+	h := agyHarness{}
+	for _, path := range []string{
+		"testdata/agy/transcript-simple.jsonl",
+		"testdata/agy/transcript-tool.jsonl",
+		"testdata/agy/transcript-stop-continue.jsonl",
+		"testdata/agy/transcript-queued.jsonl",
+	} {
+		if state, detail := h.TurnState(path); state != TurnDone {
+			t.Errorf("%s: state = %q (%q), want done", path, state, detail)
+		}
+	}
+	dir := t.TempDir()
+	// A turn ending in a tool call, a tool result, a user message or a stop
+	// gate's system message is still running.
+	running := map[string]string{
+		"tool call":   `{"step_index":1,"type":"PLANNER_RESPONSE","status":"DONE","tool_calls":[{"name":"run_command","args":{}}]}`,
+		"tool result": `{"step_index":2,"type":"GENERIC","status":"DONE","content":"output"}`,
+		"user input":  `{"step_index":0,"type":"USER_INPUT","status":"DONE","content":"hi"}`,
+		"system note": `{"step_index":2,"type":"SYSTEM_MESSAGE","status":"DONE","content":"Stop hook blocked termination"}`,
+	}
+	for name, rec := range running {
+		p := filepath.Join(dir, name+".jsonl")
+		os.WriteFile(p, []byte(rec+"\n"), 0o644)
+		if state, _ := h.TurnState(p); state != TurnRunning {
+			t.Errorf("%s: state = %q, want running", name, state)
+		}
+	}
+	// The probe recorded error_message as a step type beside system_message:
+	// a turn ending in one failed.
+	errPath := filepath.Join(dir, "err.jsonl")
+	os.WriteFile(errPath, []byte(`{"step_index":3,"type":"error_message","status":"DONE","content":"model exploded"}`+"\n"), 0o644)
+	if state, detail := h.TurnState(errPath); state != TurnFailed || !strings.Contains(detail, "model exploded") {
+		t.Errorf("error turn: state = %q (%q), want failed with the error", state, detail)
+	}
+	if _, ok := h.LastReply(errPath); ok {
+		t.Errorf("a failed turn has no final reply")
+	}
+}
+// TestAgyModelsGroupsEffortSuffixedIds parses the captured `agy models`
+// output: Gemini ids differing only by an effort suffix become one base model
+// with those efforts. Bare and lone-suffixed ids take no efforts: agy rejects
+// --effort for the former as unsupported and for the latter as conflicting
+// (both verified live), so offering levels would only fail at launch.
+func TestAgyModelsGroupsEffortSuffixedIds(t *testing.T) {
+	fixture, err := os.ReadFile("testdata/agy/models.txt")
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Setenv("EL_AGY", "fake-agy")
+	var ran string
+	var args []string
+	run := func(cmd string, a []string, _ ExecOpts) (Result, error) {
+		ran, args = cmd, a
+		return Result{Stdout: string(fixture)}, nil
+	}
+	got, err := (agyHarness{}).Models(run)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if ran != "fake-agy" || !reflect.DeepEqual(args, []string{"models"}) {
+		t.Fatalf("agy listing ran %s %v", ran, args)
+	}
+	want := []Model{
+		// The Claude ids take no --effort: agy rejects it for them as
+		// unsupported (verified live), so no levels are offered and they
+		// launch exactly as listed.
+		{ID: "claude-opus-4-6-thinking", Label: "Claude Opus 4.6 (Thinking)"},
+		{ID: "claude-sonnet-4-6", Label: "Claude Sonnet 4.6 (Thinking)"},
+		{ID: "gemini-3.1-pro", Label: "Gemini 3.1 Pro", Efforts: []string{"low", "high"}, Grouped: true},
+		{ID: "gemini-3.6-flash", Label: "Gemini 3.6 Flash", Efforts: []string{"low", "medium", "high"}, Grouped: true},
+		{ID: "gemini-3.7-flash", Label: "Gemini 3.7 Flash", Efforts: []string{"low", "medium", "high"}, Grouped: true},
+		{ID: "gemini-3.8-flash", Label: "Gemini 3.8 Flash", Efforts: []string{"low", "medium", "high"}, Grouped: true},
+		// gpt-oss-120b-medium is a lone suffixed id with no siblings: it
+		// stays ungrouped with no efforts, so it launches as listed and an
+		// --effort flag (which would conflict) is never added.
+		{ID: "gpt-oss-120b-medium", Label: "GPT-OSS 120B (Medium)"},
+	}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("agy models = %+v, want %+v", got, want)
+	}
+}
+// TestAgyModelsGroupingNeedsSiblings keeps a lone suffixed id ungrouped: only
+// two or more ids sharing a base form a group, so a launch never invents an
+// id agy never listed.
+func TestAgyModelsGroupingNeedsSiblings(t *testing.T) {
+	run := func(string, []string, ExecOpts) (Result, error) {
+		return Result{Stdout: "solo-medium\tSolo (Medium)\nplain\tPlain\n"}, nil
+	}
+	got, err := (agyHarness{}).Models(run)
+	if err != nil {
+		t.Fatal(err)
+	}
+	want := []Model{
+		{ID: "plain", Label: "Plain"},
+		{ID: "solo-medium", Label: "Solo (Medium)"},
+	}
+	if !reflect.DeepEqual(got, want) {
+		t.Fatalf("agy models = %+v, want %+v", got, want)
+	}
+}
+
+// <base>-<effort> with no --effort flag: a suffixed id with an --effort flag
+// is rejected by agy. An ungrouped id carrying efforts launches as the model
+// plus --effort; today's ungrouped ids carry none, so they launch as listed.
+func TestAgyLaunchSendsGroupedModelsAsBaseDashEffort(t *testing.T) {
+	ws := isolateAgy(t)
+	writeModelCache("agy", []Model{
+		{ID: "claude-sonnet-4-6", Label: "Claude Sonnet 4.6 (Thinking)"},
+		// future-1 stands in for an ungrouped id that takes efforts, the
+		// shape agy's --effort flag is for; no listed id takes one today.
+		{ID: "future-1", Label: "Future 1", Efforts: []string{"low", "high"}},
+		{ID: "gemini-3.8-flash", Label: "Gemini 3.8 Flash", Efforts: []string{"low", "medium", "high"}, Grouped: true},
+		{ID: "gemini-3.1-pro", Label: "Gemini 3.1 Pro", Efforts: []string{"low", "high"}, Grouped: true},
+		{ID: "gpt-oss-120b-medium", Label: "GPT-OSS 120B (Medium)"},
+	})
+	launch := func(model, effort string) []string {
+		t.Helper()
+		cmd, err := BuildCommand("agy", Session{Role: "work", Cwd: ws, Label: "01-x", Model: model, Effort: effort, Prompt: "p"})
+		if err != nil {
+			t.Fatal(err)
+		}
+		return cmd.Args
+	}
+	if got := argValue(launch("gemini-3.8-flash", "high"), "--model"); got != "gemini-3.8-flash-high" {
+		t.Errorf("grouped launch must send the suffixed id, got --model %q", got)
+	}
+	for _, args := range [][]string{launch("gemini-3.8-flash", "high"), launch("gemini-3.8-flash", "")} {
+		if got := argValue(args, "--effort"); got != "" {
+			t.Errorf("a grouped launch must never carry --effort, got %q in %q", got, args)
+		}
+	}
+	// No effort on a grouped model means agy's own default effort where it is
+	// listed, else the first listed level: the family is kept, and the id
+	// always names a model agy listed.
+	if got := argValue(launch("gemini-3.8-flash", ""), "--model"); got != "gemini-3.8-flash-medium" {
+		t.Errorf("grouped launch without effort must default the effort, got --model %q", got)
+	}
+	ungrouped := launch("future-1", "high")
+	if got := argValue(ungrouped, "--model"); got != "future-1" {
+		t.Errorf("ungrouped launch must send the model as listed, got --model %q", got)
+	}
+	if got := argValue(ungrouped, "--effort"); got != "high" {
+		t.Errorf("ungrouped launch must send --effort high, got %q in %q", got, ungrouped)
+	}
+	bare := launch("claude-sonnet-4-6", "")
+	if got := argValue(bare, "--model"); got != "claude-sonnet-4-6" {
+		t.Errorf("an effort-less launch must send the model as listed, got --model %q", got)
+	}
+	if got := argValue(bare, "--effort"); got != "" {
+		t.Errorf("no effort must add no flag, got --effort %q", got)
+	}
+	if got := argValue(launch("claude-sonnet-4-6", ""), "--effort"); got != "" {
+		t.Errorf("no effort must add no flag, got --effort %q", got)
+	}
+	// A lone suffixed id launches as listed, and a hand-set effort beside it
+	// is dropped rather than sent into a conflict error.
+	lone := launch("gpt-oss-120b-medium", "high")
+	if got := argValue(lone, "--model"); got != "gpt-oss-120b-medium" {
+		t.Errorf("lone suffixed launch must send the id as listed, got --model %q", got)
+	}
+	if got := argValue(lone, "--effort"); got != "" {
+		t.Errorf("a suffixed id must never carry --effort, got %q in %q", got, lone)
+	}
+	// No model means the harness's defaults: no model or effort flags at all.
+	none := launch("", "high")
+	if got := argValue(none, "--model"); got != "" {
+		t.Errorf("no model must add no --model, got %q in %q", got, none)
+	}
+	if got := argValue(none, "--effort"); got != "" {
+		t.Errorf("an effort without a model must add no --effort, got %q in %q", got, none)
+	}
+}
+// TestAgyLaunchWithoutACacheFallsBackToTheSyntacticShape maps model and
+// effort without a cache entry: an effort beside a suffix-less model takes
+// the <base>-<effort> shape, the common agy case.
+func TestAgyLaunchWithoutACacheFallsBackToTheSyntacticShape(t *testing.T) {
+	ws := isolateAgy(t)
+	cmd, err := BuildCommand("agy", Session{Role: "work", Cwd: ws, Label: "01-x", Model: "gemini-3.8-flash", Effort: "high", Prompt: "p"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got := argValue(cmd.Args, "--model"); got != "gemini-3.8-flash-high" {
+		t.Errorf("cache-less grouped launch must send the suffixed id, got --model %q", got)
+	}
+	if got := argValue(cmd.Args, "--effort"); got != "" {
+		t.Errorf("cache-less grouped launch must carry no --effort, got %q", got)
+	}
+}
+// TestAgySessionTranscriptMapsTheSessionToItsConversation resolves the
+// conversation id agy minted from the session's log file, then the
+// transcript under the brain dir: el sessions never share agy's id.
+func TestAgySessionTranscriptMapsTheSessionToItsConversation(t *testing.T) {
+	home := t.TempDir()
+	t.Setenv("HOME", home)
+	isolateState(t)
+	sess := Session{ID: "sess-9", Role: "work", Cwd: t.TempDir()}
+	if got := (agyHarness{}).SessionTranscript(sess); got != "" {
+		t.Fatalf("no log means no transcript, got %q", got)
+	}
+	conv := "8448858c-c907-40c0-a756-45699ecd8f9e"
+	logs := filepath.Join(home, ".gemini", "antigravity-cli", "brain", conv, ".system_generated", "logs")
+	if err := os.MkdirAll(logs, 0o755); err != nil {
+		t.Fatal(err)
+	}
+	full := filepath.Join(logs, "transcript_full.jsonl")
+	simple := filepath.Join(logs, "transcript.jsonl")
+	if err := os.WriteFile(full, []byte("{}\n"), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.MkdirAll(filepath.Dir(agyLogPath(sess)), 0o755); err != nil {
+		t.Fatal(err)
+	}
+	logText := "project: switching to conversation belonging to project ID: default-cli-project\n" +
+		"instance d69575d5-b652-4f4a-841f-40e7e2bd0497 started\n" +
+		"Forwarding user message to conversation " + conv + " (items=1)\n"
+	if err := os.WriteFile(agyLogPath(sess), []byte(logText), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if got := (agyHarness{}).SessionTranscript(sess); got != full {
+		t.Errorf("transcript = %q, want %q", got, full)
+	}
+	os.Remove(full)
+	os.WriteFile(simple, []byte("{}\n"), 0o644)
+	if got := (agyHarness{}).SessionTranscript(sess); got != simple {
+		t.Errorf("transcript fallback = %q, want %q", got, simple)
+	}
+}
