+// Building an agy command never touches the user's global agy config, except
+// for the trust entry Trust owns: the agent, plugin and log live under the
+// workspace and el's state dir.
+func TestAgyBuildLeavesTheGlobalConfigAlone(t *testing.T) {
+	ws := isolateAgy(t)
+	home := os.Getenv("HOME")
+	before := snapshotDir(t, home)
+	sess := Session{Role: "work", Cwd: ws, Label: "01-x", Prompt: "p"}
+	if _, err := BuildCommand("agy", sess); err != nil {
+		t.Fatal(err)
+	}
+	after := snapshotDir(t, home)
+	for path, content := range after {
+		old, ok := before[path]
+		if !ok {
+			// The only file a build may create under HOME is the trust
+			// entrypoint; everything generated belongs to the workspace.
+			if path != filepath.Join(home, ".gemini", "antigravity-cli", "settings.json") {
+				t.Errorf("agy build created global file %s", path)
+			}
+			continue
+		}
+		if old == content {
+			continue
+		}
+		if path != filepath.Join(home, ".gemini", "antigravity-cli", "settings.json") {
+			t.Errorf("agy build modified global file %s", path)
+		}
+	}
+}
+
+func snapshotDir(t *testing.T, root string) map[string]string {
+	t.Helper()
+	out := map[string]string{}
+	_ = filepath.Walk(root, func(p string, info os.FileInfo, err error) error {
+		if err != nil || info.IsDir() {
+			return nil
+		}
+		raw, err := os.ReadFile(p)
+		if err != nil {
+			return nil
+		}
+		out[p] = string(raw)
+		return nil
+	})
+	return out
+}
