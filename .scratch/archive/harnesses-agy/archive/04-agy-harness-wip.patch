+package el
+
+// The agy harness runs a session on the agy CLI against the user's
+// Antigravity subscription. agy only loads a workspace agent by name, so the
+// harness generates a stripped agent per role and tool set under the
+// session's own workspace (.agents/agents/el-*/): no default prompt
+// sections, no built-in tools, only el's MCP server, with el's system
+// prompt. The agent and its plugin are content-addressed by role and tool
+// set, so concurrent sessions sharing them write identical files through an
+// atomic rename instead of racing. Nothing is written to the user's global
+// agy config; trust for the workspace is the one exception, handled by Trust
+// the way the claude harness handles its own trust dialog flag.
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"regexp"
+	"sort"
+	"strings"
+	"time"
+
+	eltools "example.com/el/tools"
+)
+// agyBin is the CLI the harness launches. EL_AGY points a test at a fake.
+func agyBin() string {
+	if p := os.Getenv("EL_AGY"); p != "" {
+		return p
+	}
+	return "agy"
+}
+
+type agyHarness struct{}
+
+func (agyHarness) Name() string { return "agy" }
+
+// agy takes its first message as a startup argument, so there is no late
+// prompt: the launch file carries the full prompt as a real argument.
+func (agyHarness) LatePrompt() bool { return false }
+
+// agy blocks a stop through its Stop hook (wired by a later ticket), but it
+// cannot pin the submit tool, so its gate blocks and reminds only.
+func (agyHarness) Gate() Gate { return agyGate{} }
+
+type agyGate struct{}
+
+func (agyGate) CanPin() bool { return false }
+
+// SessionRoot is where agy writes every session's transcript: one
+// conversation directory per session under the CLI's data dir. A session's
+// own conversation id is minted at launch, so TranscriptFor (below) maps a
+// el session to its transcript through the per-session log file.
+func (agyHarness) SessionRoot(Session) string {
+	home, _ := os.UserHomeDir()
+	return filepath.Join(home, ".gemini", "antigravity-cli", "brain")
+}
+
+func (agyHarness) Command(s Session) (Command, error) {
+	ws, err := agyWorkspace(s)
+	if err != nil {
+		return Command{}, err
+	}
+	name, err := ensureAgyAgent(ws, s)
+	if err != nil {
+		return Command{}, err
+	}
+	args := []string{"--agent", name}
+	args = append(args, agyModelArgs(s.Model, s.Effort, agyCachedModels())...)
+	args = append(args, "--dangerously-skip-permissions", "--log-file", agyLogPath(s))
+	if s.Prompt != "" {
+		if s.Headless {
+			args = append(args, "-p", s.Prompt)
+		} else {
+			// Prompts are read only from -p, --prompt-interactive or stdin:
+			// a positional prompt would be ignored, so the first message
+			// travels as the --prompt-interactive value, last.
+			args = append(args, "--prompt-interactive", s.Prompt)
+		}
+	} else if s.Headless {
+		args = append(args, "-p")
+	}
+	env := roleEnv(s)
+	if s.Label != "" {
+		env = append(env, "EL_AGENT_LABEL="+s.Label)
+	}
+	return Command{Bin: agyBin(), Args: args, Env: env}, nil
+}
+
+// agyWorkspace is the workspace the session's agent is generated under: the
+// session's own directory, where agy resolves --agent names.
+func agyWorkspace(s Session) (string, error) {
+	dir := s.Cwd
+	if dir == "" {
+		var err error
+		dir, err = os.Getwd()
+		if err != nil {
+			return "", err
+		}
+	}
+	return filepath.Abs(dir)
+}
+
+// agySessionTools is the effective tool set the session's el-mcp serves,
+// mirroring RoleTools and agentTools but loading types from the workspace:
+// the role's tools, or the agent type's tools plus the submit and spawn tools
+// the runtime adds. The names feed the content-addressed agent name and the
+// agent's tool docs; el-mcp itself enforces the set by role.
+func agySessionTools(ws string, s Session) ([]string, error) {
+	if s.Role == "agent" {
+		types, err := LoadAgentTypes(ws)
+		if err != nil {
+			return nil, err
+		}
+		t, ok := types[s.AgentType]
+		if !ok {
+			return nil, fmt.Errorf("unknown agent type %q", s.AgentType)
+		}
+		out := append([]string{}, t.Tools...)
+		if len(t.Spawns) > 0 {
+			out = append(out, "spawn")
+		}
+		out = append(out, "submit")
+		sort.Strings(out)
+		return out, nil
+	}
+	names, ok := roles[s.Role]
+	if !ok {
+		return nil, fmt.Errorf("unknown role %q", s.Role)
+	}
+	types := mustLoadAgentTypes(ws)
+	all := append(eltools.All(), orchestrationTools(types, spawnableNames(s.Role, types))...)
+	if names == nil {
+		out := make([]string, 0, len(all))
+		for _, t := range all {
+			out = append(out, t.Name())
+		}
+		sort.Strings(out)
+		return out, nil
+	}
+	byName := map[string]eltools.Tool{}
+	for _, t := range all {
+		byName[t.Name()] = t
+	}
+	out := make([]string, 0, len(names))
+	for _, n := range names {
+		if _, ok := byName[n]; ok {
+			out = append(out, n)
+		}
+	}
+	sort.Strings(out)
+	return out, nil
+}
+
+// agyAgentName is the workspace agent for a session, content-addressed by
+// role, agent type and tool set: sessions that agree share one definition,
+// sessions that differ never share a path.
+func agyAgentName(s Session, tools []string) string {
+	sum := sha256.Sum256([]byte(s.Role + "\x00" + s.AgentType + "\x00" + strings.Join(tools, ",")))
+	role := strings.Map(func(r rune) rune {
+		if r >= 'a' && r <= 'z' || r >= '0' && r <= '9' || r == '-' {
+			return r
+		}
+		return '-'
+	}, strings.ToLower(s.Role))
+	if role == "" {
+		role = "session"
+	}
+	return "el-" + role + "-" + hex.EncodeToString(sum[:])[:8]
+}
+
+// ensureAgyAgent writes the session's stripped agent and its el MCP plugin
+// under the workspace and excludes them from git status, returning the agent
+// name for --agent. Writes are atomic renames of identical files, so
+// concurrent sessions sharing an agent never race.
+func ensureAgyAgent(ws string, s Session) (string, error) {
+	toolNames, err := agySessionTools(ws, s)
+	if err != nil {
+		return "", err
+	}
+	name := agyAgentName(s, toolNames)
+	agentDir := filepath.Join(ws, ".agents", "agents", name)
+	pluginDir := filepath.Join(ws, ".agents", "plugins", name)
+	env := map[string]string{"EL_ROLE": s.Role}
+	if s.Role == "agent" {
+		env["EL_AGENT_TYPE"] = s.AgentType
+	}
+	// agy starts MCP servers in the plugin's directory, not the workspace, so
+	// the server is a generated wrapper that cds back before execing el-mcp.
+	// Both paths are absolute: the server must not depend on the PATH or the
+	// working directory agy hands it.
+	wrapper := filepath.Join(pluginDir, "el-mcp.sh")
+	wrapperSrc := "#!/bin/sh\n" +
+		"# Generated by el: run el's MCP server in the workspace,\n" +
+		"# whatever directory agy starts MCP servers in.\n" +
+		"cd " + agyShQuote(ws) + " || exit 1\n" +
+		"exec " + agyShQuote(agyServerCommand()) + " \"$@\"\n"
+	mcpCfg, err := json.Marshal(map[string]any{"mcpServers": map[string]any{"el": map[string]any{
+		"command": wrapper, "args": []string{}, "env": env,
+	}}})
+	if err != nil {
+		return "", err
+	}
+	serverName := name + "_el"
+	files := map[string][]byte{
+		filepath.Join(agentDir, "agent.md"):        agyAgentFile(name, s.Role, pluginDir, serverName, toolNames),
+		filepath.Join(pluginDir, "plugin.json"):   []byte(fmt.Sprintf("{\n  \"name\": %q,\n  \"description\": %q\n}\n", name, "el MCP tools")),
+		filepath.Join(pluginDir, "mcp_config.json"): append(mcpCfg, '\n'),
+	}
+	for path, data := range files {
+		if err := writeFileAtomic(path, data, 0o644); err != nil {
+			return "", err
+		}
+	}
+	if err := writeFileAtomic(wrapper, []byte(wrapperSrc), 0o755); err != nil {
+		return "", err
+	}
+	if err := ensureAgyGitExclude(ws); err != nil {
+		return "", err
+	}
+	return name, nil
+}
+
+// agyServerCommand resolves el-mcp once, so the plugin's server entry does
+// not depend on the PATH agy hands MCP servers.
+func agyServerCommand() string {
+	if p, err := exec.LookPath("el-mcp"); err == nil {
+		return p
+	}
+	return "el-mcp"
+}
+
+// agyShQuote quotes one path for the generated wrapper's POSIX shell.
+func agyAgentFile(name, role, pluginDir, serverName string, toolNames []string) []byte {
+	var b strings.Builder
+	b.WriteString("---\n")
+	fmt.Fprintf(&b, "name: %s\n", name)
+	fmt.Fprintf(&b, "description: %s\n", "el "+role+" session")
+	b.WriteString("mainAgent: true\n")
+	b.WriteString("excludeDefaultComponents: true\n")
+	b.WriteString("inheritCustomizations: false\n")
+	b.WriteString("inheritMcp: false\n")
+	b.WriteString("plugins:\n")
+	fmt.Fprintf(&b, "  - %s\n", pluginDir)
+	// An empty tools list keeps every built-in out: the agent must not reach
+	// past el's role policy. MCP tools surface as call_mcp_tool regardless
+	// of this filter, and el-mcp serves only the session's role set.
+	b.WriteString("tools: []\n")
+	b.WriteString("---\n")
+	b.WriteString("\n# Agent System Instructions\n\n")
+	b.WriteString("El's tools are the only tools you may use for file and shell work. They are\n")
+	b.WriteString("served over MCP by the attached, running server. Call them exclusively through\n")
+	b.WriteString("the `call_mcp_tool` function: it is declared and working, and the server below\n")
+	b.WriteString("is attached. Never call any other tool for file or shell work; if a task needs\n")
+	b.WriteString("something not listed here, say so instead of guessing.\n")
+	b.WriteString("\n")
+	fmt.Fprintf(&b, "Server: %q. Tools available to this session: %s.\n", serverName, strings.Join(toolNames, ", "))
+	b.WriteString("\n")
+	fmt.Fprintf(&b, "Example: to read a file, call `call_mcp_tool` with ServerName %q,\n", serverName)
+	b.WriteString("ToolName \"read\", Arguments {\"path\": \"<workspace-relative path>\"}.\n")
+	b.WriteString("Start every task with the matching `call_mcp_tool` call.\n")
+	b.WriteString("\n")
+	b.WriteString(systemPrompt)
+	b.WriteString("\n")
+	return []byte(b.String())
+}
+	fmt.Fprintf(&b, "Tools available to this session: %s.\n", strings.Join(toolNames, ", "))
+	b.WriteString("\n")
+	fmt.Fprintf(&b, "Example: to read a file, call `call_mcp_tool` with ServerName %q,\n", serverName)
+	b.WriteString("ToolName \"read\", Arguments {\"path\": \"<workspace-relative path>\"}.\n")
+	return []byte(b.String())
+}
+
+// writeFileAtomic writes data to path through a temp file and a rename, so
+// concurrent writers of identical files converge instead of interleaving.
+func writeFileAtomic(path string, data []byte, perm os.FileMode) error {
+	if err := os.MkdirAll(filepath.Dir(path), 0o755); err != nil {
+		return err
+	}
+	tmp, err := os.CreateTemp(filepath.Dir(path), ".el.tmp.*")
+	if err != nil {
+		return err
+	}
+	tmpName := tmp.Name()
+	if _, err := tmp.Write(data); err != nil {
+		tmp.Close()
+		_ = os.Remove(tmpName)
+		return err
+	}
+	if err := tmp.Close(); err != nil {
+		_ = os.Remove(tmpName)
+		return err
+	}
+	if err := os.Chmod(tmpName, perm); err != nil {
+		_ = os.Remove(tmpName)
+		return err
+	}
+	return os.Rename(tmpName, path)
+}
+
+// agyLogPath is where the session's CLI log is written (--log-file): under
+// el's state dir, named for the session, so whoever owns the session's
+// lifetime can delete it. The log carries the conversation id agy minted,
+// which maps the session to its transcript.
+func agyLogPath(s Session) string {
+	return filepath.Join(filepath.Dir(statePath), "agy-logs", sessionKey(s)+".log")
+}
+
+// agyCachedModels is the model list for launch mapping: the cache only, never
+// a fresh CLI run, so building a command stays fast and offline. A session
+// whose model was picked through validation always has a cache entry,
+// because validation rebuilds it; without one the mapping falls back to the
+// syntactic shape.
+func agyCachedModels() []Model {
+	models, err := readModelCache("agy")
+	if err != nil {
+		return nil
+	}
+	return models
+}
+
+// sessionKey names one session's files under el's state dir.
+func sessionKey(s Session) string {
+	key := s.ID
+	if key == "" {
+		key = s.Label
+	}
+	if key == "" {
+		key = s.Role
+	}
+	if key == "" {
+		key = "session"
+	}
+	key = strings.ReplaceAll(key, "/", "-")
+	key = strings.ReplaceAll(key, "\\", "-")
+	return key
+}
+
+// Trust marks dir as trusted by appending it to trustedWorkspaces in agy's
+// settings, the flag the folder-trust dialog writes when a person accepts
+// it. Every other setting is preserved: queue mode and the rest of the
+// user's global config are never touched.
+// ponytail: read-modify-write without a lock; an agy running at the same
+// instant can overwrite it, and the dialog would then just appear once more.
+func (agyHarness) Trust(dir string) error {
+	dir, err := filepath.Abs(dir)
+	if err != nil {
+		return err
+	}
+	home, err := os.UserHomeDir()
+	if err != nil {
+		return err
+	}
+	path := filepath.Join(home, ".gemini", "antigravity-cli", "settings.json")
+	cfg := map[string]any{}
+	if b, err := os.ReadFile(path); err == nil {
+		if err := json.Unmarshal(b, &cfg); err != nil {
+			return fmt.Errorf("%s is not valid JSON: %w", path, err)
+		}
+	} else if !os.IsNotExist(err) {
+		return err
+	}
+	var trusted []any
+	if list, ok := cfg["trustedWorkspaces"].([]any); ok {
+		trusted = list
+	}
+	for _, v := range trusted {
+		if v == dir {
+			return nil
+		}
+	}
+	cfg["trustedWorkspaces"] = append(trusted, dir)
+	out, err := json.MarshalIndent(cfg, "", "  ")
+	if err != nil {
+		return err
+	}
+	if err := os.MkdirAll(filepath.Dir(path), 0o755); err != nil {
+		return err
+	}
+	return writeFileAtomic(path, append(out, '\n'), 0o600)
+}
+
+// agyGitExcludeBlock keeps the generated agents out of git status. The block
+// is constant, so concurrent rewrites converge on the same file.
+const agyGitExcludeBlock = "# el: agy harness sessions (managed by el; safe to delete)\n" +
+	".agents/agents/el-*/\n" +
+	".agents/plugins/el-*/\n"
+
+// ensureAgyGitExclude appends the el block to the checkout's local git
+// exclude file, so generated agents never show in git status. The patterns
+// are scoped to el-* names, so a repo's own .agents content is unaffected.
+// The block belongs to the common git dir: git does not honor a linked
+// worktree's private info/exclude (verified live: the same pattern matches
+// from the main checkout's exclude and not from the worktree's). Outside a
+// git checkout there is nothing to exclude, which is not an error.
+func ensureAgyGitExclude(ws string) error {
+	gitDir, ok := agyGitDir(ws)
+	if !ok {
+		return nil
+	}
+	if common, ok := agyCommonDir(gitDir); ok {
+		gitDir = common
+	}
+	path := filepath.Join(gitDir, "info", "exclude")
+	if err := os.MkdirAll(filepath.Dir(path), 0o755); err != nil {
+		return err
+	}
+	raw, _ := os.ReadFile(path)
+	lines := strings.Split(string(raw), "\n")
+	keep := lines[:0]
+	for _, l := range lines {
+		if l == "" || l == "# el: agy harness sessions (managed by el; safe to delete)" ||
+			l == ".agents/agents/el-*/" || l == ".agents/plugins/el-*/" {
+			continue
+		}
+		keep = append(keep, l)
+	}
+	out := strings.Join(keep, "\n")
+	if !strings.HasSuffix(out, "\n") {
+		out += "\n"
+	}
+	out += agyGitExcludeBlock
+	return writeFileAtomic(path, []byte(out), 0o644)
+}
+
+// agyGitDir is the git dir of the checkout ws lives in, from its .git entry:
+// a directory for a main checkout, a gitdir pointer file for a linked
+// worktree (whose private dir holds the worktree's own state). False when ws
+// is not in a checkout.
+func agyGitDir(ws string) (string, bool) {
+	dotGit := filepath.Join(ws, ".git")
+	info, err := os.Stat(dotGit)
+	if err != nil {
+		return "", false
+	}
+	if info.IsDir() {
+		return dotGit, true
+	}
+	raw, err := os.ReadFile(dotGit)
+	if err != nil {
+		return "", false
+	}
+	line := strings.TrimSpace(string(raw))
+	gitDir, ok := strings.CutPrefix(line, "gitdir: ")
+	if !ok {
+		return "", false
+	}
+	if !filepath.IsAbs(gitDir) {
+		gitDir = filepath.Join(ws, gitDir)
+	}
+	return gitDir, true
+}
+
+// agyCommonDir is the common git dir for a private linked-worktree dir: the
+// commondir file names it, falling back to the standard
+// <main>/.git/worktrees/<name> layout. False for a main checkout's own dir,
+// which is already common.
+func agyCommonDir(gitDir string) (string, bool) {
+	if raw, err := os.ReadFile(filepath.Join(gitDir, "commondir")); err == nil {
+		common := strings.TrimSpace(string(raw))
+		if common == "" {
+			return "", false
+		}
+		if !filepath.IsAbs(common) {
+			common = filepath.Join(gitDir, common)
+		}
+		return common, true
+	}
+	if i := strings.Index(gitDir, string(filepath.Separator)+".git"+string(filepath.Separator)+"worktrees"+string(filepath.Separator)); i >= 0 {
+		return gitDir[:i+len(string(filepath.Separator)+".git")], true
+	}
+	return "", false
+}
+// Models lists agy's models from `agy models`, grouping effort-suffixed ids
+// into one base model with the suffixes present as its efforts.
+func (agyHarness) Models(run Exec) ([]Model, error) {
+	res, err := run(agyBin(), []string{"models"}, ExecOpts{Timeout: time.Minute})
+	if err != nil {
+		return nil, err
+	}
+	if res.Code != 0 {
+		return nil, fmt.Errorf("agy models: %s", strings.TrimSpace(res.Stderr))
+	}
+	return parseAgyModels(res.Stdout), nil
+}
+// LastReply is the text of the final assistant message of a finished turn:
+// the last model step with content and no tool calls. A turn ending in a
+// tool call, a tool result or anything else is still mid-turn.
+func (agyHarness) LastReply(path string) (string, bool) {
+	return lastRecord(path, func(rec map[string]any) (string, bool) {
+		if !agyTypeIs(rec, "PLANNER_RESPONSE") {
+			return "", false
+		}
+		if calls, _ := rec["tool_calls"].([]any); len(calls) > 0 {
+			return "", false
+		}
+		content, _ := rec["content"].(string)
+		if strings.TrimSpace(content) == "" {
+			return "", false
+		}
+		return strings.TrimSpace(content), true
+	})
+}
+
+// TurnState is TurnDone when the last step is a model message with no tool
+// calls, TurnFailed when it is an error message, and TurnRunning otherwise:
+// a tool call, a tool result, a user message or an injected system message
+// all mean the turn still owes work.
+func (agyHarness) TurnState(path string) (string, string) {
+	return lastTurn(path, func(rec map[string]any) (state, detail string, ok bool) {
+		switch {
+		case agyTypeIs(rec, "error_message"):
+			content, _ := rec["content"].(string)
+			return TurnFailed, content, true
+		case agyTypeIs(rec, "PLANNER_RESPONSE"):
+			if calls, _ := rec["tool_calls"].([]any); len(calls) > 0 {
+				return TurnRunning, "", true
+			}
+			return TurnDone, "", true
+		case agyTypeIs(rec, "USER_INPUT"), agyTypeIs(rec, "GENERIC"), agyTypeIs(rec, "SYSTEM_MESSAGE"):
+			return TurnRunning, "", true
+		}
+		return "", "", false
+	})
+}
+
+func agyTypeIs(rec map[string]any, want string) bool {
+	typ, _ := rec["type"].(string)
+	return strings.EqualFold(typ, want)
+}
+
+// parseAgyModels reads the tab-separated `agy models` table. Ids that differ
+// only by an effort suffix (-low, -medium, -high, -xhigh, -max) form one base
+// model when two or more share the base, with the suffixes present as its
+// efforts in canonical order; the display name drops the effort
+// parenthetical. A lone suffixed id stays ungrouped with no efforts, so it
+// launches exactly as listed and never gains a conflicting --effort flag; so
+// does a suffixed id whose base is itself a listed bare id, which would
+// otherwise duplicate that id. Bare ids also take no efforts: agy rejects
+// --effort for them as unsupported (verified live for the Claude ids), so
+// offering levels would only fail at launch.
+func parseAgyModels(out string) []Model {
+	type entry struct{ id, label string }
+	var bare []entry
+	grouped := map[string][]entry{}
+	seenBare := map[string]bool{}
+	for _, line := range strings.Split(out, "\n") {
+		line = strings.TrimSpace(line)
+		if line == "" {
+			continue
+		}
+		id, label, _ := strings.Cut(line, "\t")
+		id, label = strings.TrimSpace(id), strings.TrimSpace(label)
+		if id == "" {
+			continue
+		}
+		if base, _, ok := splitEffortSuffix(id); ok {
+			grouped[base] = append(grouped[base], entry{id, label})
+		} else {
+			bare = append(bare, entry{id, label})
+			seenBare[id] = true
+		}
+	}
+	var models []Model
+	for _, e := range bare {
+		models = append(models, Model{ID: e.id, Label: e.label})
+	}
+	bases := make([]string, 0, len(grouped))
+	for b := range grouped {
+		bases = append(bases, b)
+	}
+	sort.Strings(bases)
+	for _, base := range bases {
+		members := grouped[base]
+		if len(members) < 2 || seenBare[base] {
+			for _, m := range members {
+				models = append(models, Model{ID: m.id, Label: m.label})
+			}
+			continue
+		}
+		present := map[string]bool{}
+		for _, m := range members {
+			_, suffix, _ := splitEffortSuffix(m.id)
+			present[suffix] = true
+		}
+		var efforts []string
+		for _, level := range agyEffortLevels {
+			if present[level] {
+				efforts = append(efforts, level)
+			}
+		}
+		sort.Slice(members, func(i, j int) bool { return members[i].id < members[j].id })
+		models = append(models, Model{ID: base, Label: stripEffortLabel(members[0].label, present), Efforts: efforts, Grouped: true})
+	}
+	sort.Slice(models, func(i, j int) bool { return models[i].ID < models[j].ID })
+	return models
+}
+
+// splitEffortSuffix cuts an effort suffix off a model id: gemini-3.8-flash-low
+// becomes its base and level. The base must be non-empty.
+func splitEffortSuffix(id string) (base, level string, ok bool) {
+	for _, effort := range agyEffortLevels {
+		if base, found := strings.CutSuffix(id, "-"+effort); found && base != "" {
+			return base, effort, true
+		}
+	}
+	return "", "", false
+}
+
+// stripEffortLabel drops a trailing effort parenthetical the grouping brought
+// in: "Gemini 3.8 Flash (High)" becomes "Gemini 3.8 Flash". A parenthetical
+// naming anything else, like "(Thinking)", stays.
+func stripEffortLabel(label string, present map[string]bool) string {
+	open := strings.LastIndex(label, " (")
+	if open < 0 || !strings.HasSuffix(label, ")") {
+		return label
+	}
+	word := label[open+2 : len(label)-1]
+	if present[strings.ToLower(word)] {
+		return label[:open]
+	}
+	return label
+}
+
+// agyModelArgs maps a resolved model and effort to agy's flags, consulting
+// the cached model list the way validation leaves it: a grouped base launches
+// as <base>-<effort> with no --effort flag, and an ungrouped id carrying
+// efforts as the model plus --effort. A suffixed id never takes --effort (agy
+// rejects the combination), and no model means no flags at all, so the
+// harness's defaults apply. A grouped base without an effort keeps its family
+// with agy's default effort where listed, else the first listed level, so the
+// id always names a model agy listed. Without a cache entry the mapping falls
+// back to the syntactic shape: an effort beside a suffix-less model takes
+// <base>-<effort>.
+func agyModelArgs(model, effort string, cached []Model) []string {
+	if model == "" {
+		return nil
+	}
+	if _, _, ok := splitEffortSuffix(model); ok {
+		return []string{"--model", model}
+	}
+	byID := map[string]Model{}
+	for _, m := range cached {
+		byID[m.ID] = m
+	}
+	if m, ok := byID[model]; ok && m.Grouped {
+		level := effort
+		if level == "" {
+			level = "medium"
+			if !contains(m.Efforts, level) && len(m.Efforts) > 0 {
+				level = m.Efforts[0]
+			}
+		}
+		if level == "" {
+			return []string{"--model", model}
+		}
+		return []string{"--model", model + "-" + level}
+	}
+	if _, ok := byID[model]; ok {
+		if effort == "" {
+			return []string{"--model", model}
+		}
+		return []string{"--model", model, "--effort", effort}
+	}
+	if effort == "" {
+		return []string{"--model", model}
+	}
+	return []string{"--model", model + "-" + effort}
+}
+// agyEffortLevels are the reasoning effort levels agy takes: the probe found
+// low, medium, high, xhigh and max, where the spec listed only the first
+// three and max.
+var agyEffortLevels = []string{"low", "medium", "high", "xhigh", "max"}
+// SessionTranscript is the session's transcript: agy mints its own
+// conversation id at launch, so the id is read from the session's CLI log
+// (--log-file) and the transcript is the conversation's full log under the
+// brain dir, falling back to the plain one. Empty while the session has not
+// started or the log names no conversation yet.
+func (agyHarness) SessionTranscript(s Session) string {
+	id := agyConversationID(agyLogPath(s))
+	if id == "" {
+		return ""
+	}
+	for _, name := range []string{"transcript_full.jsonl", "transcript.jsonl"} {
+		p := filepath.Join((agyHarness{}).SessionRoot(s), id, ".system_generated", "logs", name)
+		if info, err := os.Stat(p); err == nil && !info.IsDir() {
+			return p
+		}
+	}
+	return ""
+}
+
+// agyConversationRe finds the conversation id agy's log names: the id after
+// a conversation marker, never a bare uuid that belongs to something else.
+var agyConversationRe = regexp.MustCompile(`conversation[ =]([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})`)
+
+func agyConversationID(logPath string) string {
+	raw, err := os.ReadFile(logPath)
+	if err != nil {
+		return ""
+	}
+	m := agyConversationRe.FindStringSubmatch(string(raw))
+	if len(m) != 2 {
+		return ""
+	}
+	return m[1]
+}
