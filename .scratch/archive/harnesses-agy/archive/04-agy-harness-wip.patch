+// TestAgyGitExcludeLandsInTheCommonDir writes the block to the common git
+// dir for a linked worktree: git does not honor the worktree's private
+// info/exclude, so the gitdir pointer's commondir decides.
+func TestAgyGitExcludeLandsInTheCommonDir(t *testing.T) {
+	ws := isolateAgy(t)
