+// The stripped agent mirrors the stripped-claude test: the --agent flag names
+// a workspace agent, the definition drops agy's defaults and customizations,
+// serves only el's MCP server, and carries el's system prompt.
+func TestAgyRunsStripped(t *testing.T) {
+	ws := isolateAgy(t)
+	cmd, err := BuildCommand("agy", Session{Role: "review", Cwd: ws, Model: "m", Prompt: "p"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	line := cmd.Line()
+	for _, leak := range []string{"--skill", "--no-skills", "-e ", "--tools", "--setting-sources", "--mcp-config"} {
+		if strings.Contains(line, leak) {
+			t.Errorf("pig/claude-only flag %q leaked: %s", leak, line)
+		}
+	}
+	agent := argValue(cmd.Args, "--agent")
+	if agent == "" {
+		t.Fatalf("agy must select its workspace agent with --agent: %q", cmd.Args)
+	}
+	if strings.Contains(agent, "/") || strings.Contains(agent, string(os.PathSeparator)) {
+		t.Fatalf("--agent must be a workspace name, not a path (agy ignores outside paths): %q", agent)
+	}
+	raw, err := os.ReadFile(filepath.Join(ws, ".agents", "agents", agent, "agent.md"))
+	if err != nil {
+		t.Fatalf("cannot read the generated agent: %v", err)
+	}
+	text := string(raw)
+	for _, want := range []string{
+		"mainAgent: true",
+		"excludeDefaultComponents: true",
+		"inheritCustomizations: false",
+		"inheritMcp: false",
+		"tools: []",
+		"# Agent System Instructions",
+		systemPrompt,
+	} {
+		if !strings.Contains(text, want) {
+			t.Errorf("agent definition missing %q:\n%s", want, text)
+		}
+	}
+	// The agent attaches only the workspace plugin, by absolute path: bare
+	// names and relative paths never attach in agy runs.
+	pluginLine := ""
+	lines := strings.Split(text, "\n")
+	for i, l := range lines {
+		if strings.TrimSpace(l) == "plugins:" && i+1 < len(lines) {
+			pluginLine = strings.TrimSpace(strings.TrimPrefix(strings.TrimSpace(lines[i+1]), "-"))
+		}
+	}
+	if pluginLine == "" || !filepath.IsAbs(pluginLine) {
+		t.Fatalf("the agent's plugins entry must be an absolute path, got %q in:\n%s", pluginLine, text)
+	}
+	for _, f := range []string{"plugin.json", "mcp_config.json"} {
+		if _, err := os.Stat(filepath.Join(pluginLine, f)); err != nil {
+			t.Errorf("plugin file %s missing under %s: %v", f, pluginLine, err)
+		}
+	}
+	mcpRaw, err := os.ReadFile(filepath.Join(pluginLine, "mcp_config.json"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	var mcpCfg struct {
+		MCPServers map[string]struct {
+			Command string            `json:"command"`
+			Env     map[string]string `json:"env"`
+		} `json:"mcpServers"`
+	}
+	if err := json.Unmarshal(mcpRaw, &mcpCfg); err != nil {
+		t.Fatalf("mcp_config.json is not JSON: %v", err)
+	}
+	if len(mcpCfg.MCPServers) != 1 {
+		t.Fatalf("the agent must serve only el's MCP server, got %s", mcpRaw)
+	}
+	srv := mcpCfg.MCPServers["el"]
+	if srv.Command == "" {
+		t.Errorf("the one MCP server must be el's, got %s", mcpRaw)
+	}
+	if srv.Env["EL_ROLE"] != "review" {
+		t.Errorf("the MCP server must carry the session role, got %s", mcpRaw)
+	}
+	// The server is the generated wrapper at its absolute path: agy starts
+	// MCP servers in the plugin directory, so the wrapper cds back to the
+	// workspace before execing el-mcp.
+	wrapper := filepath.Join(pluginLine, "el-mcp.sh")
+	if srv.Command != wrapper {
+		t.Errorf("the server command must be the workspace wrapper %s, got %s", wrapper, srv.Command)
+	}
+	wrapperSrc, err := os.ReadFile(wrapper)
+	if err != nil {
+		t.Fatalf("cannot read the server wrapper: %v", err)
+	}
+	if info, err := os.Stat(wrapper); err != nil || info.Mode()&0o111 == 0 {
+		t.Errorf("the server wrapper must be executable: %v", err)
+	}
+	for _, want := range []string{"cd ", ws, "exec ", "el-mcp"} {
+		if !strings.Contains(string(wrapperSrc), want) {
+			t.Errorf("the wrapper must cd to the workspace and exec el-mcp, missing %q in:\n%s", want, wrapperSrc)
+		}
+	}
+	// The agent carries the calling convention for el's tools: agy never
+	// enumerates MCP server names, so without it the model cannot find its
+	// tools and confabulates instead.
+	serverName := agent + "_el"
+	for _, want := range []string{"call_mcp_tool", serverName, "Tools available to this session: find, read"} {
+		if !strings.Contains(text, want) {
+			t.Errorf("agent definition missing %q:\n%s", want, text)
+		}
+	}
+}
+// Concurrent sessions sharing a role and tool set write the same agent
+// through atomic renames: they agree on the name and converge on identical
+// files instead of racing.
+func TestAgyAgentWritesDoNotRace(t *testing.T) {
+	ws := isolateAgy(t)
+	sess := Session{Role: "work", Cwd: ws, Label: "race", Prompt: "p"}
+	const n = 8
+	names := make([]string, n)
+	errs := make([]error, n)
+	var wg sync.WaitGroup
+	for i := 0; i < n; i++ {
+		wg.Add(1)
+		go func(i int) {
+			defer wg.Done()
+			cmd, err := BuildCommand("agy", sess)
+			if err != nil {
+				errs[i] = err
+				return
+			}
+			names[i] = argValue(cmd.Args, "--agent")
+		}(i)
+	}
+	wg.Wait()
+	for i, err := range errs {
+		if err != nil {
+			t.Fatalf("concurrent build %d: %v", i, err)
+		}
+		if names[i] != names[0] || names[0] == "" {
+			t.Fatalf("concurrent builds disagree on the agent: %q", names)
+		}
+	}
+	// Sessions with different tool sets never share a path.
+	other, err := BuildCommand("agy", Session{Role: "review", Cwd: ws, Label: "race", Prompt: "p"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got := argValue(other.Args, "--agent"); got == names[0] {
+		t.Fatalf("different tool sets share agent %q", got)
+	}
+	raw, err := os.ReadFile(filepath.Join(ws, ".agents", "agents", names[0], "agent.md"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !strings.Contains(string(raw), systemPrompt) {
+		t.Errorf("the raced-on agent is not the stripped one:\n%s", raw)
+	}
+}
