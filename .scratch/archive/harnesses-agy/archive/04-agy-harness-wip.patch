+package el
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+	"testing"
+)
+// TestPrintAgyScoutLaunch is a manual-verification helper, not a real test:
+// it builds an agy scout launch against the real worktree and prints the
+// pieces the operator types into a herdr pane by hand. It is deleted before
+// the ticket is committed.
+func TestPrintAgyScoutLaunch(t *testing.T) {
+	cwd, err := filepath.Abs("..")
+	if err != nil {
+		t.Fatal(err)
+	}
+	sess := Session{
+		Role:   "review",
+		Cwd:    cwd,
+		ID:     newSessionID(),
+		Prompt: "Use read on el/go.mod. Reply with only its first line.\n\nYour last message is your answer.",
+	}
+	launch, err := PrepareLaunch("agy", sess)
+	if err != nil {
+		t.Fatal(err)
+	}
+	file, _ := execFileFromLine(launch.Line)
+	cmd, _ := readLaunch(file)
+	out := fmt.Sprintf("SESSION=%s\nLINE=%s\nLOG=%s\nTRANSCRIPT=%s\nAGENT=%s\nMODEL=%s EFFORT=%s\n",
+		sess.ID, launch.Line, agyLogPath(sess), (agyHarness{}).SessionTranscript(sess),
+		argValue(cmd.Args, "--agent"), argValue(cmd.Args, "--model"), argValue(cmd.Args, "--effort"))
+	if err := os.WriteFile("/tmp/agy-scout-launch.txt", []byte(out), 0o644); err != nil {
+		t.Fatal(err)
+	}
+}
