{
  "name": "el-web-ui",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "build": "vite build && vite build --ssr src/ssr.js --outDir dist/ssr && EL_SSR_HYDRATE_BUILD=1 vite build",
    "test": "vitest run",
    "test:e2e": "npm run build && npm --prefix e2e install --no-audit --no-fund && npm --prefix e2e test",
    "dev:api": "cd .. && go run ./cmd/emberloop-web -addr 127.0.0.1:8910",
    "dev:ui": "API_PORT=8910 UI_PORT=5190 vite",
    "dev": "bun run --parallel dev:api dev:ui",
    "prod:api": "cd .. && go build -o bin/el-web ./cmd/emberloop-web && ./bin/el-web -addr 127.0.0.1:8920",
    "prod:ui": "API_PORT=8920 UI_PORT=8921 vite preview",
    "prod": "npm run build && bun run --parallel prod:api prod:ui"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.1",
    "@lucide/svelte": "^1.57.0",
    "@panzoom/panzoom": "^4.6.2",
    "@tanstack/svelte-virtual": "^3.13.46",
    "bits-ui": "^2.19.5",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.17",
    "marked": "^18.1.1",
    "svelte": "^5.57.2",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "uisfx": "^0.4.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "jsdom": "^30.1.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
